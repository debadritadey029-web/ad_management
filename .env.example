# Environment variable template for AdVantage AI
# Public values may be exposed to the browser. Never place secrets in VITE_* variables.
GEMINI_API_KEY=
APP_URL=http://localhost:3000

# Supabase browser configuration (public; enforce RLS in Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase configuration. NEVER use the VITE_ prefix for this key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Security modes. Keep demo auth and dev OTP codes disabled in all deployed environments.
APP_ENV=development
ENABLE_DEMO_AUTH=false
ENABLE_DEV_OTP_CODE=false
